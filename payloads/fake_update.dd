REM fakeupdate.io + fullscreen where possible.
DELAY 2500
IF_WIN
GUI r
DELAY 1000
STRING https://fakeupdate.io/windows-11?timer=0
ENTER
DELAY 3500
F11
END_IF
IF_MAC
GUI SPACE
DELAY 800
STRING https://fakeupdate.io/windows-11?timer=0
ENTER
DELAY 3500
CTRL GUI f
END_IF
IF_LINUX
ALT F2
DELAY 800
STRING xdg-open https://fakeupdate.io/windows-11?timer=0
ENTER
DELAY 3500
F11
END_IF
