REM HID-trust awareness banner.
DELAY 2500
IF_WIN
GUI r
DELAY 1000
STRING notepad
ENTER
DELAY 1200
STRINGLN WARNING: this machine trusts USB keyboards.
STRINGLN Authorized awareness demo only.
END_IF
IF_MAC
GUI SPACE
DELAY 800
STRING textedit
ENTER
DELAY 1200
STRINGLN WARNING: this machine trusts USB keyboards.
STRINGLN Authorized awareness demo only.
END_IF
IF_LINUX
CTRL ALT t
DELAY 1200
STRINGLN echo 'WARNING: this machine trusts USB keyboards.'
STRINGLN echo 'Authorized awareness demo only.'
END_IF
