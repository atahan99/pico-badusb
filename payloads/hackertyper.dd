REM hackertyper.com
DELAY 2500
IF_WIN
GUI r
DELAY 1000
STRING https://hackertyper.com
ENTER
END_IF
IF_MAC
GUI SPACE
DELAY 800
STRING https://hackertyper.com
ENTER
END_IF
IF_LINUX
ALT F2
DELAY 800
STRING xdg-open https://hackertyper.com
ENTER
END_IF
IF_ANDROID
STRING https://hackertyper.com
ENTER
END_IF
