REM Countdown 3-2-1.
DELAY 2500
IF_WIN
GUI r
DELAY 1000
STRING notepad
ENTER
DELAY 1200
STRINGLN Countdown
STRINGLN 3
DELAY 600
STRINGLN 2
DELAY 600
STRINGLN 1
DELAY 600
STRINGLN Go!
END_IF
IF_MAC
GUI SPACE
DELAY 800
STRING textedit
ENTER
DELAY 1200
STRINGLN Countdown
STRINGLN 3
DELAY 600
STRINGLN 2
DELAY 600
STRINGLN 1
DELAY 600
STRINGLN Go!
END_IF
IF_LINUX
ALT F2
DELAY 800
STRING gedit
ENTER
DELAY 1200
STRINGLN Countdown
STRINGLN 3
DELAY 600
STRINGLN 2
DELAY 600
STRINGLN 1
DELAY 600
STRINGLN Go!
END_IF
