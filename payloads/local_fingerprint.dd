REM Local OS fingerprint (authorized demo).
DELAY 2500
IF_WIN
GUI r
DELAY 1000
STRING cmd
ENTER
DELAY 1000
STRING ver> %TEMP%\badusb-fp.txt & systeminfo | findstr /B /C:"OS Name" /C:"OS Version">> %TEMP%\badusb-fp.txt & notepad %TEMP%\badusb-fp.txt
ENTER
END_IF
IF_MAC
GUI SPACE
DELAY 800
STRING terminal
ENTER
DELAY 1200
STRING sw_vers > /tmp/badusb-fp.txt && uname -a >> /tmp/badusb-fp.txt && open -e /tmp/badusb-fp.txt
ENTER
END_IF
IF_LINUX
CTRL ALT t
DELAY 1200
STRING uname -a > /tmp/badusb-fp.txt; cat /etc/os-release >> /tmp/badusb-fp.txt; (xdg-open /tmp/badusb-fp.txt || cat /tmp/badusb-fp.txt)
ENTER
END_IF
